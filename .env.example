PORT=3000
# Alternativa simples para desenvolvimento local.
ML_ACCESS_TOKEN=

# OAuth do Mercado Livre (obrigatório no deploy).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://SEU-PROJETO.vercel.app/integracao/mercadolivre/retorno
ML_SITE_ID=MLB

# Shopee Open Platform (Partner ID e Partner Key do app no console da Shopee).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://SEU-PROJETO.vercel.app/integracao/shopee/retorno
# Use 1 com as credenciais de teste (sandbox) da Shopee.
SHOPEE_SANDBOX=

# TikTok Shop Partner Center (App key, App secret e Service ID do app).
# O Redirect URL do app deve ser https://SEU-PROJETO.vercel.app/integracao/tiktok/retorno
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# Identificação do produto pela foto (Gemini, chave gratuita em aistudio.google.com).
# Na camada gratuita o Google pode usar as fotos enviadas para melhorar os produtos dele.
GEMINI_API_KEY=
# Opcional: outro modelo do Gemini (padrão gemini-3.8-flash).
GEMINI_MODEL=
# IDs de usuário do Mercado Livre que podem usar a foto, separados por vírgula (vazio = qualquer conta conectada).
VISION_ALLOWED_ML_USERS=

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase Auth (use apenas a chave publicável).
SUPABASE_URL=https://mjvwqmzmjkbigghtteqp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_rleXMwByIubnrqrbGHAe4g_AV3SxyOF

# Somente no servidor: chave secreta do Supabase, nunca na página pública.
SUPABASE_SECRET_KEY=
# Checkout Pro: R$ 1 por análise, sem assinatura.
APP_URL=https://e-commerce-gold-three-68.vercel.app
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Ative somente depois de configurar e validar os pagamentos.
MP_PAYMENTS_ENABLED=0
